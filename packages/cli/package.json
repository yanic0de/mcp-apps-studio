{
  "name": "mcp-apps-studio",
  "version": "0.0.0",
  "description": "Storybook + Playwright for MCP Apps widgets: stories with mocked tool calls, a faithful local host, and headless story runs in CI.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanic0de/mcp-app-proba.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "mcp",
    "mcp-apps",
    "ext-apps",
    "storybook",
    "widget",
    "testing",
    "playwright"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./src/vite-plugin.ts"
  },
  "publishConfig": {
    "access": "public",
    "bin": {
      "mcp-apps-studio": "./dist/bin.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./vite": {
        "types": "./dist/vite.d.ts",
        "import": "./dist/vite.js"
      }
    }
  },
  "scripts": {
    "build": "tsup && node scripts/copy-assets.mjs",
    "start": "tsx src/bin.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "esbuild": "^0.25.0",
    "pixelmatch": "^7.2.0",
    "playwright-core": "1.61.1",
    "pngjs": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@studio/app": "workspace:*",
    "@studio/components": "workspace:*",
    "@studio/shared": "workspace:*",
    "@types/node": "^26.1.1",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.23.1",
    "typescript": "~5.8.0",
    "yaml": "^2.9.1"
  }
}
